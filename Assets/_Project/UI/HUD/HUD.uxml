<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Themes/Theme.uss" />
    <Style src="HUD.uss" />
    <Style src="HudBuild.uss" />
    <Style src="HudInteraction.uss" />
    <Style src="HudLoot.uss" />
    <Style src="HudIntel.uss" />
    <Style src="HudPerks.uss" />
    <Style src="HudFeel.uss" />
    <!-- Element adları HudElementNames.cs ile eşleşmeli (EditMode testi kontrol eder). Metinler burada; kod sadece sayı ve veri
         adlarını yazar. Tuş ipuçlarında klavye ve gamepad karşılığı yan yana: kökteki lh-gamepad sınıfı hangisinin görüneceğini
         seçer (HudInputHintsController). -->
    <ui:VisualElement name="hud" class="lh-screen hud" picking-mode="Ignore">
        <!-- Gündüzün son 15 sn'si (HudDayWarningController): ekran kenarında kırmızı nabız (iki kat kenarlık; kod "dim" sınıfını
             transition bitişlerinde açıp kapatır) ve büyük geri sayım (saniye değişince kod "tick" sınıfıyla kısa büyütür).
             İlk çocuk: her şeyin altında çizilir. -->
        <ui:VisualElement name="day-warning" class="hud-day-warning hidden" picking-mode="Ignore">
            <ui:VisualElement name="day-warning-pulse" class="hud-day-warning__pulse" picking-mode="Ignore">
                <ui:VisualElement class="hud-day-warning__edge hud-day-warning__edge--outer" picking-mode="Ignore" />
                <ui:VisualElement class="hud-day-warning__edge hud-day-warning__edge--inner" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="hud-day-countdown-group" picking-mode="Ignore">
                <ui:Label name="day-countdown" text="15" class="label-huge hud-day-countdown" picking-mode="Ignore" />
                <ui:Label text="GECE YAKLAŞIYOR" class="label-large hud-day-countdown-caption" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Ganimet sandığı kenar göstergeleri (gündüz): ekran dışındaki en yakın sandıkların yönü. Gösterge sayısı buradaki
             hud-edge-indicator sayısı; kod merkezini kenara koyar ve ok taşıyıcısını döndürür (HudLootIndicatorsController).
             Kutulardan önce: diğer HUD kutuları bunun üstünde çizilir (göstergeler kutuları örtmez). -->
        <ui:VisualElement name="loot-indicators" class="hud-loot-indicators" picking-mode="Ignore">
            <ui:VisualElement class="hud-edge-indicator hidden" picking-mode="Ignore">
                <ui:VisualElement class="hud-edge-indicator__icon" picking-mode="Ignore" />
                <ui:VisualElement class="hud-edge-indicator__pivot" picking-mode="Ignore">
                    <ui:VisualElement class="hud-edge-indicator__arrow" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="hud-edge-indicator hidden" picking-mode="Ignore">
                <ui:VisualElement class="hud-edge-indicator__icon" picking-mode="Ignore" />
                <ui:VisualElement class="hud-edge-indicator__pivot" picking-mode="Ignore">
                    <ui:VisualElement class="hud-edge-indicator__arrow" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="hud-edge-indicator hidden" picking-mode="Ignore">
                <ui:VisualElement class="hud-edge-indicator__icon" picking-mode="Ignore" />
                <ui:VisualElement class="hud-edge-indicator__pivot" picking-mode="Ignore">
                    <ui:VisualElement class="hud-edge-indicator__arrow" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Saldırı yönü okları (gündüz istihbaratı, GDD §9): bu gecenin her saldırı yönü için ekran dışındaki spawn bölgesine dönen
             kırmızı ok. Her yönün kendi göstergesi ve harfi var (Kuzey, Doğu, Güney, Batı); kod merkezini kenara koyar ve ok
             taşıyıcısını döndürür (HudAttackIndicatorsController). Sandık göstergelerinin üstünde çizilir. -->
        <ui:VisualElement name="attack-indicators" class="hud-attack-indicators" picking-mode="Ignore">
            <ui:VisualElement name="attack-indicator-north" class="hud-edge-indicator hud-edge-indicator--attack hidden" picking-mode="Ignore">
                <ui:VisualElement class="hud-edge-indicator__icon" picking-mode="Ignore">
                    <ui:Label text="K" class="label hud-edge-indicator__letter" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-edge-indicator__pivot" picking-mode="Ignore">
                    <ui:VisualElement class="hud-edge-indicator__arrow" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="attack-indicator-east" class="hud-edge-indicator hud-edge-indicator--attack hidden" picking-mode="Ignore">
                <ui:VisualElement class="hud-edge-indicator__icon" picking-mode="Ignore">
                    <ui:Label text="D" class="label hud-edge-indicator__letter" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-edge-indicator__pivot" picking-mode="Ignore">
                    <ui:VisualElement class="hud-edge-indicator__arrow" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="attack-indicator-south" class="hud-edge-indicator hud-edge-indicator--attack hidden" picking-mode="Ignore">
                <ui:VisualElement class="hud-edge-indicator__icon" picking-mode="Ignore">
                    <ui:Label text="G" class="label hud-edge-indicator__letter" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-edge-indicator__pivot" picking-mode="Ignore">
                    <ui:VisualElement class="hud-edge-indicator__arrow" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="attack-indicator-west" class="hud-edge-indicator hud-edge-indicator--attack hidden" picking-mode="Ignore">
                <ui:VisualElement class="hud-edge-indicator__icon" picking-mode="Ignore">
                    <ui:Label text="B" class="label hud-edge-indicator__letter" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-edge-indicator__pivot" picking-mode="Ignore">
                    <ui:VisualElement class="hud-edge-indicator__arrow" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Uçan yazılar (HudFloatingTextController): hasar sayıları ve "+12" jeton yazıları. Etiketleri kod oluşturur ve her kare
             dünyadan ekrana yansıtır. HUD kutularından önce: kutular yazıların üstünde çizilir. -->
        <ui:VisualElement name="floating-texts" class="hud-float-layer" picking-mode="Ignore" />
        <!-- Evre başlığı (HudBannerController): gündüz/gece/şafak geçişinde ve boss doğunca ekran ortasında büyük başlık. Sadece bir
             grup görünür; kod sayıyı ve alt yazıyı (gece olayının / boss'un adı) yazar, opaklığı ve boyu sürer. -->
        <ui:VisualElement name="banner" class="hud-banner hidden" picking-mode="Ignore">
            <ui:VisualElement name="banner-day" class="row hud-banner__group hud-banner__group--day hidden" picking-mode="Ignore">
                <ui:Label text="GÜN" class="label-huge hud-banner__title" picking-mode="Ignore" />
                <ui:Label name="banner-day-number" text="1" class="label-huge hud-banner__title hud-banner__number" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="banner-night" class="row hud-banner__group hud-banner__group--night hidden" picking-mode="Ignore">
                <ui:Label text="GECE" class="label-huge hud-banner__title" picking-mode="Ignore" />
                <ui:Label name="banner-night-number" text="1" class="label-huge hud-banner__title hud-banner__number" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="banner-dawn" class="row hud-banner__group hud-banner__group--dawn hidden" picking-mode="Ignore">
                <ui:Label text="ŞAFAK" class="label-huge hud-banner__title" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="banner-boss" class="row hud-banner__group hud-banner__group--boss hidden" picking-mode="Ignore">
                <ui:Label text="BOSS" class="label-huge hud-banner__title" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="banner-subtitle" text="" class="label-large hud-banner__subtitle hidden" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="hud-top" picking-mode="Ignore">
            <ui:VisualElement class="panel hud-phase-panel" picking-mode="Ignore">
                <ui:VisualElement class="row" picking-mode="Ignore">
                    <ui:Label name="phase-day" text="GÜNDÜZ" class="label-big hud-phase-name hud-phase-name--day hidden" picking-mode="Ignore" />
                    <ui:Label name="phase-dusk" text="ALACAKARANLIK" class="label-big hud-phase-name hud-phase-name--dusk hidden" picking-mode="Ignore" />
                    <ui:Label name="phase-night" text="GECE" class="label-big hud-phase-name hud-phase-name--night hidden" picking-mode="Ignore" />
                    <ui:Label name="phase-dawn" text="ŞAFAK" class="label-big hud-phase-name hud-phase-name--dawn hidden" picking-mode="Ignore" />
                    <ui:Label name="phase-game-over" text="OYUN BİTTİ" class="label-big hud-phase-name hud-phase-name--game-over hidden" picking-mode="Ignore" />
                    <ui:Label name="phase-victory" text="ZAFER" class="label-big hud-phase-name hud-phase-name--victory hidden" picking-mode="Ignore" />
                    <ui:Label name="day-timer" text="2:00" class="label-big hidden" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="row" picking-mode="Ignore">
                    <ui:Label text="GECE" class="label-small hud-caption" picking-mode="Ignore" />
                    <ui:Label name="night-value" text="1/10" class="label-large" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="remaining-group" class="row hud-remaining hidden" picking-mode="Ignore">
                    <ui:Label text="KALAN DÜŞMAN" class="label-small hud-caption" picking-mode="Ignore" />
                    <ui:Label name="remaining-value" text="0" class="label-large text-danger" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- "Hazırım" ipucu (gündüz; HudReadyHintController): bonus 0 iken "— +X bonus" kısmı gizli. -->
            <ui:VisualElement name="ready-hint" class="panel row hud-ready-hint hidden" picking-mode="Ignore">
                <ui:Label text="Enter" class="key key--keyboard" picking-mode="Ignore" />
                <ui:Label text="Start (basılı)" class="key key--gamepad" picking-mode="Ignore" />
                <ui:Label text="Hazırım" class="label" picking-mode="Ignore" />
                <ui:VisualElement name="ready-bonus" class="row" picking-mode="Ignore">
                    <ui:Label text="—" class="label hud-ready-hint__dash" picking-mode="Ignore" />
                    <ui:Label name="ready-bonus-value" text="+0" class="label hud-ready-hint__bonus" picking-mode="Ignore" />
                    <ui:Label text="bonus" class="label" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- Boss (gece; HudBossController): boss doğunca ad + büyük can barı; ölünce gizlenir. Ad boss verisinden (DisplayName). -->
            <ui:VisualElement name="boss-panel" class="panel hud-boss hidden" picking-mode="Ignore">
                <ui:VisualElement class="row-spread" picking-mode="Ignore">
                    <ui:VisualElement class="row" picking-mode="Ignore">
                        <ui:Label text="BOSS" class="label-small hud-boss__tag" picking-mode="Ignore" />
                        <ui:Label name="boss-name" text="" class="label-large hud-boss__name" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="boss-health-value" text="0/0" class="label" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="bar hud-boss__bar" picking-mode="Ignore">
                    <ui:VisualElement name="boss-health-fill" class="bar-fill bar-fill--boss" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="hud-top-right" picking-mode="Ignore">
            <ui:VisualElement class="panel" picking-mode="Ignore">
                <ui:VisualElement class="row-spread" picking-mode="Ignore">
                    <ui:Label text="JENERATÖR" class="label-small" picking-mode="Ignore" />
                    <ui:Label name="generator-health-value" text="0/0" class="label" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="bar" picking-mode="Ignore">
                    <ui:VisualElement name="generator-health-fill" class="bar-fill bar-fill--generator" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="panel hud-wallet" picking-mode="Ignore">
                <ui:VisualElement class="row-spread" picking-mode="Ignore">
                    <ui:Label text="PARA" class="label-small" picking-mode="Ignore" />
                    <ui:Label name="money-value" text="0" class="label-large hud-money" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="row-spread hud-wallet-row" picking-mode="Ignore">
                    <ui:Label text="YAKIT" class="label-small" picking-mode="Ignore" />
                    <ui:Label name="fuel-value" text="0" class="label-large hud-fuel" picking-mode="Ignore" />
                </ui:VisualElement>
                <!-- Yakıt barı (yakıt / kapasite) ve bu gecenin tüketimiyle tahmini süre (HudFuelController). -->
                <ui:VisualElement class="bar hud-fuel-bar" picking-mode="Ignore">
                    <ui:VisualElement name="fuel-fill" class="bar-fill bar-fill--fuel" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="row-spread hud-wallet-row" picking-mode="Ignore">
                    <ui:Label text="TAHMİNİ SÜRE" class="label-small" picking-mode="Ignore" />
                    <ui:Label name="fuel-estimate" text="0:00" class="label hud-fuel" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- Güç yokken görünür; kod "dim" sınıfını transition bitişlerinde açıp kapatarak yanıp söndürür (HudFuelController). -->
            <ui:VisualElement name="power-warning" class="panel hud-power-warning hidden" picking-mode="Ignore">
                <ui:Label text="GÜÇ YOK" class="label-big" picking-mode="Ignore" />
            </ui:VisualElement>
            <!-- İstihbarat (gündüz; HudIntelController): bu gecenin düşman tipleri + adetleri ve gece olayı. Satır sayısı = bir gecedeki
                 en fazla tip (5 tip + boss); kullanılmayan satırlar gizli. -->
            <ui:VisualElement name="intel-panel" class="panel hud-intel hidden" picking-mode="Ignore">
                <ui:Label text="BU GECE" class="label-small hud-intel__title" picking-mode="Ignore" />
                <ui:VisualElement name="intel-enemies" picking-mode="Ignore">
                    <ui:VisualElement class="row hud-intel-row hidden" picking-mode="Ignore">
                        <ui:Label text="0" class="label-large hud-intel-row__count" picking-mode="Ignore" />
                        <ui:Label text="" class="label hud-intel-row__name" picking-mode="Ignore" />
                        <ui:Label text="BOSS" class="label-small hud-intel-row__boss hidden" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row hud-intel-row hidden" picking-mode="Ignore">
                        <ui:Label text="0" class="label-large hud-intel-row__count" picking-mode="Ignore" />
                        <ui:Label text="" class="label hud-intel-row__name" picking-mode="Ignore" />
                        <ui:Label text="BOSS" class="label-small hud-intel-row__boss hidden" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row hud-intel-row hidden" picking-mode="Ignore">
                        <ui:Label text="0" class="label-large hud-intel-row__count" picking-mode="Ignore" />
                        <ui:Label text="" class="label hud-intel-row__name" picking-mode="Ignore" />
                        <ui:Label text="BOSS" class="label-small hud-intel-row__boss hidden" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row hud-intel-row hidden" picking-mode="Ignore">
                        <ui:Label text="0" class="label-large hud-intel-row__count" picking-mode="Ignore" />
                        <ui:Label text="" class="label hud-intel-row__name" picking-mode="Ignore" />
                        <ui:Label text="BOSS" class="label-small hud-intel-row__boss hidden" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row hud-intel-row hidden" picking-mode="Ignore">
                        <ui:Label text="0" class="label-large hud-intel-row__count" picking-mode="Ignore" />
                        <ui:Label text="" class="label hud-intel-row__name" picking-mode="Ignore" />
                        <ui:Label text="BOSS" class="label-small hud-intel-row__boss hidden" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row hud-intel-row hidden" picking-mode="Ignore">
                        <ui:Label text="0" class="label-large hud-intel-row__count" picking-mode="Ignore" />
                        <ui:Label text="" class="label hud-intel-row__name" picking-mode="Ignore" />
                        <ui:Label text="BOSS" class="label-small hud-intel-row__boss hidden" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <!-- Gece olayı (GDD §14): ad ve açıklama olay verisinden (NightModifierData). -->
                <ui:VisualElement name="intel-event" class="hud-intel__event hidden" picking-mode="Ignore">
                    <ui:VisualElement class="row-spread" picking-mode="Ignore">
                        <ui:Label text="OLAY" class="label-small" picking-mode="Ignore" />
                        <ui:Label name="intel-event-name" text="" class="label-large hud-intel__event-name" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="intel-event-description" text="" class="label-small hud-intel__event-description" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Kombo (sağ orta): kombo yokken gizli; eşik atlanınca kod "pulse" sınıfıyla kısa büyütür (HudComboController.PulseClass). -->
        <ui:VisualElement name="combo-group" class="panel hud-combo hidden" picking-mode="Ignore">
            <ui:VisualElement class="row hud-combo-numbers" picking-mode="Ignore">
                <ui:Label name="combo-multiplier" text="×1.5" class="label-big hud-combo-multiplier hidden" picking-mode="Ignore" />
                <ui:Label name="combo-count" text="0" class="label-huge hud-combo-count" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label text="KOMBO" class="label-small" picking-mode="Ignore" />
            <ui:VisualElement class="bar hud-combo-bar" picking-mode="Ignore">
                <ui:VisualElement name="combo-window-fill" class="bar-fill bar-fill--combo" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Sol alt sütun: alınan perk'ler (HudPerksController; rozetleri kod ekler, perk yokken gizli) ve can kutusu. Rozetin
             üstüne gelince sütunun üstünde perk ipucu açılır (nadirlik sınıfı adın rengini ve nadirlik etiketini seçer). Rozetler
             fareyi yakalar (üzerine gelme); diğer her şey Ignore. -->
        <ui:VisualElement class="hud-bottom-left" picking-mode="Ignore">
            <ui:VisualElement name="perk-tooltip" class="panel hud-perk-tooltip hidden" picking-mode="Ignore">
                <ui:VisualElement class="row-spread hud-perk-tooltip__header" picking-mode="Ignore">
                    <ui:Label name="perk-tooltip-name" text="" class="label-large hud-perk-tooltip__name" picking-mode="Ignore" />
                    <ui:Label name="perk-tooltip-stacks" text="0/0" class="label" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label text="SIRADAN" class="label-small hud-perk-tooltip__rarity hud-perk-tooltip__rarity--common" picking-mode="Ignore" />
                <ui:Label text="NADİR" class="label-small hud-perk-tooltip__rarity hud-perk-tooltip__rarity--rare" picking-mode="Ignore" />
                <ui:Label text="EPİK" class="label-small hud-perk-tooltip__rarity hud-perk-tooltip__rarity--epic" picking-mode="Ignore" />
                <ui:Label name="perk-tooltip-description" text="" class="label-small hud-perk-tooltip__description" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="perk-list" class="hud-perks hidden" picking-mode="Ignore" />
            <ui:VisualElement class="panel" picking-mode="Ignore">
                <ui:VisualElement class="row-spread" picking-mode="Ignore">
                    <ui:Label text="CAN" class="label-small" picking-mode="Ignore" />
                    <ui:Label name="player-health-value" text="0/0" class="label" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="bar" picking-mode="Ignore">
                    <ui:VisualElement name="player-health-fill" class="bar-fill" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="panel hud-bottom-right" picking-mode="Ignore">
            <ui:Label name="weapon-name" text="—" class="label-large" picking-mode="Ignore" />
            <ui:Label name="ammo-value" text="0 / 0" class="label-big hud-ammo" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- XP ve seviye (alt orta, ince şerit; HudXpController): seviye numarası, bu seviyenin XP barı ve "XP/eşik". Seviye
             atlayınca kod seviye numarasını "pulse" sınıfıyla kısa büyütür (HudXpController.PulseClass). İnşa çubuğundan önce:
             inşa çubuğu bunun üstünde çizilir. -->
        <ui:VisualElement name="xp-group" class="panel row hud-xp" picking-mode="Ignore">
            <ui:Label text="SV" class="label-small hud-xp__caption" picking-mode="Ignore" />
            <ui:Label name="xp-level" text="1" class="label hud-xp__level" picking-mode="Ignore" />
            <ui:VisualElement class="bar hud-xp__bar" picking-mode="Ignore">
                <ui:VisualElement name="xp-fill" class="bar-fill bar-fill--xp" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="xp-value" text="0/0" class="label-tiny hud-xp__value" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- İnşa çubuğu (alt orta, sadece inşa modunda): kartları BuildCard.uxml'den kod ekler (HudBuildBarController). -->
        <ui:VisualElement name="build-bar" class="hud-build-bar hidden" picking-mode="Ignore">
            <ui:VisualElement class="panel hud-build-panel" picking-mode="Ignore">
                <ui:Label text="İNŞA" class="label-small hud-build-title" picking-mode="Ignore" />
                <ui:VisualElement name="build-cards" class="row hud-build-cards" picking-mode="Ignore" />
                <ui:Label name="build-description" text="" class="label-small hud-build-description hidden" picking-mode="Ignore" />
                <ui:Label name="build-no-selection" text="Bir yapı seç ya da bir yapının üzerine gel." class="label-small hud-build-description" picking-mode="Ignore" />
                <ui:VisualElement class="row hud-build-hints" picking-mode="Ignore">
                    <ui:VisualElement class="row hud-build-hint" picking-mode="Ignore">
                        <ui:Label text="1–5" class="key key--keyboard" picking-mode="Ignore" />
                        <ui:Label text="D-pad ←→" class="key key--gamepad" picking-mode="Ignore" />
                        <ui:Label text="seç" class="label-tiny" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row hud-build-hint" picking-mode="Ignore">
                        <ui:Label text="Q" class="key key--keyboard" picking-mode="Ignore" />
                        <ui:Label text="RB" class="key key--gamepad" picking-mode="Ignore" />
                        <ui:Label text="döndür" class="label-tiny" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row hud-build-hint" picking-mode="Ignore">
                        <ui:Label text="Sol tık" class="key key--keyboard" picking-mode="Ignore" />
                        <ui:Label text="RT / A" class="key key--gamepad" picking-mode="Ignore" />
                        <ui:Label text="yerleştir" class="label-tiny" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row hud-build-hint" picking-mode="Ignore">
                        <ui:Label text="U" class="key key--keyboard" picking-mode="Ignore" />
                        <ui:Label text="D-pad ↑" class="key key--gamepad" picking-mode="Ignore" />
                        <ui:Label text="yükselt" class="label-tiny" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row hud-build-hint" picking-mode="Ignore">
                        <ui:Label text="X" class="key key--keyboard" picking-mode="Ignore" />
                        <ui:Label text="D-pad ↓" class="key key--gamepad" picking-mode="Ignore" />
                        <ui:Label text="sat" class="label-tiny" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row hud-build-hint" picking-mode="Ignore">
                        <ui:Label text="Sağ tık" class="key key--keyboard" picking-mode="Ignore" />
                        <ui:Label text="B" class="key key--gamepad" picking-mode="Ignore" />
                        <ui:Label text="iptal" class="label-tiny" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row hud-build-hint" picking-mode="Ignore">
                        <ui:Label text="B" class="key key--keyboard" picking-mode="Ignore" />
                        <ui:Label text="LB" class="key key--gamepad" picking-mode="Ignore" />
                        <ui:Label text="kapat" class="label-tiny" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Yapı ipucu (inşa modunda üzerine gelinen yapının tepesinde; HudStructureTooltipController konumlar). -->
        <ui:VisualElement name="structure-tooltip" class="panel hud-tooltip hidden" picking-mode="Ignore">
            <ui:VisualElement class="row-spread hud-tooltip__title" picking-mode="Ignore">
                <ui:VisualElement class="row hud-tooltip__names" picking-mode="Ignore">
                    <ui:Label name="tooltip-name" text="Yapı" class="label-large" picking-mode="Ignore" />
                    <ui:Label name="tooltip-level-name" text="" class="label hud-tooltip__level-name" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="tooltip-level" text="1/1" class="label hud-tooltip__level" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="row-spread" picking-mode="Ignore">
                <ui:Label text="CAN" class="label-small" picking-mode="Ignore" />
                <ui:Label name="tooltip-health-value" text="0/0" class="label" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="bar hud-tooltip__bar" picking-mode="Ignore">
                <ui:VisualElement name="tooltip-health-fill" class="bar-fill bar-fill--structure" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="tooltip-upgrade" class="row-spread hud-tooltip__action" picking-mode="Ignore">
                <ui:VisualElement class="row" picking-mode="Ignore">
                    <ui:Label text="U" class="key key--keyboard" picking-mode="Ignore" />
                    <ui:Label text="D-pad ↑" class="key key--gamepad" picking-mode="Ignore" />
                    <ui:Label text="Yükselt" class="label" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="tooltip-upgrade-cost" text="0" class="label hud-tooltip__cost" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="tooltip-max-level" class="row hud-tooltip__action hidden" picking-mode="Ignore">
                <ui:Label text="En üst seviye" class="label hud-tooltip__max" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="row-spread hud-tooltip__action" picking-mode="Ignore">
                <ui:VisualElement class="row" picking-mode="Ignore">
                    <ui:Label text="X" class="key key--keyboard" picking-mode="Ignore" />
                    <ui:Label text="D-pad ↓" class="key key--gamepad" picking-mode="Ignore" />
                    <ui:Label text="Sat" class="label" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="tooltip-sell-refund" text="+0" class="label hud-tooltip__cost" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Etkileşim ipucu (onarım, acil yakıt...): nesnenin üstünde; halka basılı tutma ilerlemesi (HudInteractionPromptController). -->
        <ui:VisualElement name="interaction-prompt" class="panel hud-prompt hidden" picking-mode="Ignore">
            <ui:VisualElement name="interaction-ring" class="hud-prompt__ring" picking-mode="Ignore">
                <ui:Label text="E" class="label hud-prompt__key key--keyboard" picking-mode="Ignore" />
                <ui:Label text="B" class="label hud-prompt__key key--gamepad" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label text="—" class="label hud-prompt__dash" picking-mode="Ignore" />
            <ui:Label name="interaction-text" text="" class="label hud-prompt__text" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
