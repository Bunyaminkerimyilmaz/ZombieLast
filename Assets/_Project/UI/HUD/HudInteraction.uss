/*
 * Etkileşim ipucu (GDD §16 "E — Aç"): etkileşilebilir nesnenin üstünde (WorldAnchor) tuş + ipucu metni. Tuş, basılı tutma
 * ilerleme halkasının ortasında. Halka: elementin kenarlığı izdir (--color-ring-track), dolan yay kodla çizilir
 * (ProgressRing): rengi elementin "color"ı, kalınlığı kenarlık kalınlığı.
 * Seçiciler .lh-screen.hud ile başlar: Theme.uss'teki iki sınıflı kuralları kesin ezsin diye.
 */

/* margin-bottom = nesneye ve ekran kenarına bırakılan boşluk; margin-left/top sıfır kalmalı (konumu kod yazar). */
.lh-screen.hud .hud-prompt {
    position: absolute;
    left: 0;
    top: 0;
    flex-direction: row;
    align-items: center;
    margin: 0 0 var(--space) 0;
    padding: var(--space-small) var(--space-large) var(--space-small) var(--space-small);
}

.lh-screen.hud .hud-prompt__ring {
    width: 52px;
    height: 52px;
    border-radius: 26px;
    border-width: var(--border-thick);
    border-color: var(--color-ring-track);
    color: var(--color-ring-fill);
    align-items: center;
    justify-content: center;
}

.lh-screen.hud .hud-prompt__key {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--color-key);
}

.lh-screen.hud .hud-prompt__dash {
    color: var(--color-text-dim);
    margin: 0 var(--space);
}

.lh-screen.hud .hud-prompt__text {
    -unity-font-style: bold;
}
