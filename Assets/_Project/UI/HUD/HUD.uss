/*
 * HUD yerleşimi (1920×1080 referans). Renkler, yazı boyutları, kenar boşlukları, bar ve kenarlık kalınlıkları Theme.uss
 * değişkenlerinden; burada sadece kutuların konumu ve genişliği yazılır (renk/yazı değeri yazma: UIGenerationTests kontrol eder).
 * İnşa çubuğu ve yapı ipucu HudBuild.uss'te, etkileşim ipucu HudInteraction.uss'te.
 * Seçiciler .lh-screen.hud ile başlar: Theme.uss'teki iki sınıflı .lh-screen .label-* kurallarını kesin ezsin diye.
 */

.lh-screen.hud .hud-top {
    position: absolute;
    top: var(--hud-edge-top);
    left: 0;
    right: 0;
    align-items: center;
}

.lh-screen.hud .hud-phase-panel {
    align-items: center;
    min-width: 380px;
}

.lh-screen.hud .hud-phase-name {
    margin-right: var(--space-large);
}

.lh-screen.hud .hud-phase-name--day {
    color: var(--color-day);
}

.lh-screen.hud .hud-phase-name--dusk {
    color: var(--color-dusk);
}

.lh-screen.hud .hud-phase-name--night {
    color: var(--color-night);
}

.lh-screen.hud .hud-phase-name--dawn {
    color: var(--color-dawn);
}

.lh-screen.hud .hud-phase-name--game-over {
    color: var(--color-danger);
}

.lh-screen.hud .hud-phase-name--victory {
    color: var(--color-success);
}

.lh-screen.hud .hud-caption {
    margin-right: var(--space);
}

.lh-screen.hud .hud-remaining {
    margin-top: var(--space-small);
}

/* Boss barı: üst ortada, evre kutusunun altında (gece "Hazırım" ipucu gizli). */
.lh-screen.hud .hud-boss {
    margin-top: var(--space);
    width: 760px;
}

.lh-screen.hud .hud-boss__tag {
    color: var(--color-boss);
    margin-right: var(--space);
}

.lh-screen.hud .hud-boss__name {
    color: var(--color-boss);
}

.lh-screen.hud .hud-boss__bar {
    height: var(--bar-height-large);
}

.lh-screen.hud .bar-fill--boss {
    background-color: var(--color-boss);
}

/* Sağ üst sütun: jeneratör barı, altında cüzdan (para + yakıt). */
.lh-screen.hud .hud-top-right {
    position: absolute;
    top: var(--hud-edge-top);
    right: var(--hud-edge);
    width: 380px;
}

.lh-screen.hud .hud-wallet {
    margin-top: var(--space);
}

.lh-screen.hud .hud-wallet-row {
    margin-top: var(--space-small);
}

.lh-screen.hud .hud-money {
    color: var(--color-money);
}

.lh-screen.hud .hud-fuel {
    color: var(--color-fuel);
}

.lh-screen.hud .hud-fuel-bar {
    height: var(--bar-height-small);
}

.lh-screen.hud .bar-fill--fuel {
    background-color: var(--color-fuel);
}

/* Güç yok: kırmızı kutu; kod hud-power-warning--dim'i her transition bitişinde açıp kapatır (yanıp sönme hızı burada). */
.lh-screen.hud .hud-power-warning {
    margin-top: var(--space);
    align-items: center;
    background-color: var(--color-danger-back);
    border-width: var(--border);
    border-color: var(--color-danger);
    transition-property: opacity;
    transition-duration: 0.45s;
    transition-timing-function: ease-in-out;
}

.lh-screen.hud .hud-power-warning--dim {
    opacity: 0.25;
}

/* Kombo: sağ orta. Eşik atlanınca kod hud-combo--pulse ekler; transition bitince kaldırır, aynı transition geri küçültür. */
.lh-screen.hud .hud-combo {
    position: absolute;
    right: var(--hud-edge);
    top: 50%;
    translate: 0 -50%;
    min-width: 220px;
    align-items: flex-end;
    transform-origin: right;
    transition-property: scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.lh-screen.hud .hud-combo--pulse {
    scale: 1.3 1.3;
}

.lh-screen.hud .hud-combo-numbers {
    align-items: flex-end;
}

.lh-screen.hud .hud-combo-count {
    color: var(--color-combo);
}

.lh-screen.hud .hud-combo-multiplier {
    color: var(--color-money);
    margin-right: var(--space);
    margin-bottom: var(--space-small);
}

.lh-screen.hud .hud-combo-bar {
    width: 100%;
    height: var(--bar-height-thin);
}

.lh-screen.hud .bar-fill--combo {
    background-color: var(--color-combo);
}

/* Sol alt sütun (saydam): perk listesi (HudPerks.uss) + can kutusu; alttan büyür. */
.lh-screen.hud .hud-bottom-left {
    position: absolute;
    bottom: var(--hud-edge);
    left: var(--hud-edge);
    width: 440px;
}

.lh-screen.hud .hud-bottom-right {
    position: absolute;
    bottom: var(--hud-edge);
    right: var(--hud-edge);
    min-width: 280px;
    align-items: flex-end;
}

.lh-screen.hud .hud-ammo {
    margin-top: var(--space-small);
}

/* Şarjör ile yedek arasındaki "/" (15.2: ayrı etiketler; boşluklar etiket metninden kırpıldığı için kenar boşluğu). */
.lh-screen.hud .hud-ammo__separator {
    margin: 0 var(--space);
}

/* XP ve seviye: alt ortada ince şerit (can ve silah kutularının arasında; inşa çubuğu bunun üstünde, HudBuild.uss).
 * Seviye atlayınca kod hud-xp__level--pulse ekler; transition bitince kaldırır, aynı transition geri küçültür. */
.lh-screen.hud .hud-xp {
    position: absolute;
    bottom: var(--hud-edge);
    left: 50%;
    translate: -50% 0;
    width: 760px;
    padding: var(--space-small) var(--space);
}

.lh-screen.hud .hud-xp__caption {
    color: var(--color-xp);
    margin-right: var(--space-small);
}

.lh-screen.hud .hud-xp__level {
    color: var(--color-xp);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    min-width: 32px;
    transition-property: scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.lh-screen.hud .hud-xp__level--pulse {
    scale: 1.6 1.6;
}

.lh-screen.hud .hud-xp__bar {
    flex-grow: 1;
    height: var(--bar-height-xp);
    margin: 0 var(--space);
}

/* Dolum genişliğini kod yazar; ilk kareye kadar boş görünsün. */
.lh-screen.hud .bar-fill--xp {
    width: 0;
    background-color: var(--color-xp);
}

.lh-screen.hud .hud-xp__value {
    min-width: 72px;
    -unity-text-align: middle-right;
}
