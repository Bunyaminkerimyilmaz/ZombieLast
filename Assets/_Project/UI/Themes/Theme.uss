/*
 * Last Haven — ortak tema: renk değişkenleri, yazı boyutları ve ortak sınıflar.
 * Her ekranın UXML kökü .lh-screen sınıfını taşır; değişkenler oradan alt elementlere geçer.
 * Varsayılan temayı (.unity-label, .unity-button) ezmek için seçiciler .lh-screen ile başlar.
 */

.lh-screen {
    --color-text: rgb(240, 240, 236);
    --color-text-dim: rgb(168, 176, 188);
    --color-text-shadow: rgba(0, 0, 0, 0.85);
    --color-panel: rgba(10, 14, 20, 0.74);
    --color-panel-border: rgba(255, 255, 255, 0.12);
    --color-overlay: rgba(4, 6, 10, 0.62);
    --color-bar-back: rgba(0, 0, 0, 0.6);
    --color-bar-border: rgba(0, 0, 0, 0.9);
    --color-health: rgb(214, 66, 66);
    --color-generator: rgb(236, 196, 64);
    --color-money: rgb(255, 214, 90);
    --color-fuel: rgb(240, 150, 70);
    --color-combo: rgb(255, 120, 72);
    --color-accent: rgb(244, 180, 64);
    --color-danger: rgb(232, 80, 72);
    --color-danger-back: rgba(120, 20, 18, 0.88);
    --color-success: rgb(112, 200, 112);
    --color-day: rgb(250, 214, 110);
    --color-dusk: rgb(240, 140, 80);
    --color-night: rgb(128, 160, 240);
    --color-dawn: rgb(250, 190, 150);
    --color-button: rgb(46, 54, 66);
    --color-button-hover: rgb(66, 78, 94);
    --color-button-active: rgb(34, 40, 50);
    --color-focus: rgb(255, 236, 170);
    --color-backdrop: rgba(4, 6, 10, 0.35);
    --color-window: rgb(12, 16, 22);
    --color-card: rgba(26, 32, 42, 0.94);
    --color-card-border: rgba(255, 255, 255, 0.14);
    --color-success-back: rgba(40, 96, 48, 0.94);
    --color-dot-empty: rgba(255, 255, 255, 0.18);
    --color-structure: rgb(112, 200, 112);
    --color-selected: rgb(255, 214, 90);
    --color-selected-back: rgba(70, 60, 24, 0.94);
    --color-swatch: rgb(120, 128, 140);
    --color-key: rgb(240, 240, 236);
    --color-key-back: rgba(255, 255, 255, 0.14);
    --color-key-border: rgba(255, 255, 255, 0.55);
    --color-ring-track: rgba(255, 255, 255, 0.22);
    --color-ring-fill: rgb(255, 214, 90);
    --color-loot: rgb(160, 97, 42);
    --color-loot-border: rgba(0, 0, 0, 0.85);
    --color-loot-arrow: rgb(255, 190, 110);
    --color-attack: rgb(214, 48, 40);
    --color-attack-border: rgba(0, 0, 0, 0.85);
    --color-attack-arrow: rgb(255, 92, 76);
    --color-warning-edge-outer: rgba(220, 28, 20, 0.26);
    --color-warning-edge-inner: rgba(230, 36, 28, 0.5);
    --color-boss: rgb(196, 36, 44);
    --color-xp: rgb(112, 196, 255);
    /* Uçan hasar sayıları (14.1): normal ve büyük hasar. Jeton yazıları --color-money. */
    --color-damage-text: rgb(255, 246, 224);
    --color-damage-big: rgb(255, 146, 54);
    /* Perk nadirliği (GDD §13): kart çerçevesi, HUD rozeti; -back seçili kartın / rozetin zemini. */
    --color-rarity-common: rgb(204, 210, 220);
    --color-rarity-common-back: rgba(54, 60, 70, 0.96);
    --color-rarity-rare: rgb(84, 158, 255);
    --color-rarity-rare-back: rgba(22, 48, 92, 0.96);
    --color-rarity-epic: rgb(196, 110, 255);
    --color-rarity-epic-back: rgba(62, 26, 98, 0.96);
    /* Menüler (14.3): odaksız ayar satırının görünmez çerçevesi. */
    --color-transparent: rgba(0, 0, 0, 0);

    --font-tiny: 15px;
    --font-small: 18px;
    --font-normal: 24px;
    --font-large: 34px;
    --font-big: 52px;
    --font-huge: 88px;
    --font-giant: 150px;

    --space-small: 6px;
    --space: 12px;
    --space-large: 24px;
    --radius: 6px;
    --border-thin: 1px;
    --border: 2px;
    --border-thick: 4px;

    /* HUD kutularının ekran kenarına uzaklığı ve bar kalınlıkları. */
    --hud-edge: 24px;
    --hud-edge-top: 20px;
    --bar-height: 22px;
    --bar-height-large: 30px;
    --bar-height-small: 14px;
    --bar-height-thin: 12px;
    --bar-height-xp: 10px;
    --bar-radius: 4px;

    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Kodun kullandığı görünürlük sınıfı (UIClassNames.Hidden): ekranın kendisinde veya içindeki bir elementte. */
.lh-screen.hidden,
.lh-screen .hidden {
    display: none;
}

/* --- Yazılar --- */

.lh-screen .label,
.lh-screen .label-small,
.lh-screen .label-large,
.lh-screen .label-big,
.lh-screen .label-huge {
    color: var(--color-text);
    margin: 0;
    padding: 0;
    text-shadow: 2px 2px 0 var(--color-text-shadow);
}

.lh-screen .label {
    font-size: var(--font-normal);
}

.lh-screen .label-small {
    font-size: var(--font-small);
    color: var(--color-text-dim);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.lh-screen .label-large {
    font-size: var(--font-large);
    -unity-font-style: bold;
}

.lh-screen .label-big {
    font-size: var(--font-big);
    -unity-font-style: bold;
}

.lh-screen .label-huge {
    font-size: var(--font-huge);
    -unity-font-style: bold;
}

.lh-screen .text-accent {
    color: var(--color-accent);
}

.lh-screen .text-danger {
    color: var(--color-danger);
}

.lh-screen .text-success {
    color: var(--color-success);
}

/* --- Kutular --- */

.lh-screen .panel {
    background-color: var(--color-panel);
    border-width: var(--border-thin);
    border-color: var(--color-panel-border);
    border-radius: var(--radius);
    padding: var(--space) var(--space-large);
}

.lh-screen .overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-overlay);
    align-items: center;
    justify-content: center;
}

.lh-screen .row {
    flex-direction: row;
    align-items: center;
}

.lh-screen .row-spread {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}

/* --- Barlar: .bar içinde .bar-fill; dolum genişliğini kod yüzde olarak yazar. --- */

.lh-screen .bar {
    height: var(--bar-height);
    margin-top: var(--space-small);
    background-color: var(--color-bar-back);
    border-width: var(--border);
    border-color: var(--color-bar-border);
    border-radius: var(--bar-radius);
    overflow: hidden;
}

.lh-screen .bar-fill {
    width: 100%;
    height: 100%;
    background-color: var(--color-health);
}

.lh-screen .bar-fill--generator {
    background-color: var(--color-generator);
}

/* --- Butonlar --- */

.lh-screen .button {
    font-size: var(--font-large);
    -unity-font-style: bold;
    color: var(--color-text);
    background-color: var(--color-button);
    border-width: var(--border);
    border-color: var(--color-accent);
    border-radius: var(--radius);
    min-width: 280px;
    margin: var(--space) 0 0 0;
    padding: var(--space) var(--space-large);
}

.lh-screen .button:hover {
    background-color: var(--color-button-hover);
}

.lh-screen .button:active {
    background-color: var(--color-button-active);
}

/* --- Küçük yazı (HUD'da ikincil bilgi: kart numarası, ipucu satırı) --- */

.lh-screen .label-tiny {
    font-size: var(--font-tiny);
    color: var(--color-text-dim);
    margin: 0;
    padding: 0;
    text-shadow: 2px 2px 0 var(--color-text-shadow);
}

/* --- Tuş rozetleri ---
 * Bir eylemin klavye ve gamepad tuşu yan yana yazılır (.key--keyboard / .key--gamepad). Ekranın kökünde lh-gamepad sınıfı
 * varken gamepad'inki, yokken klavyeninki görünür (HudInputHintsController, UIClassNames.Gamepad). Bu elementlere "hidden"
 * verme: görünürlüklerini bu kurallar yönetir. */

.lh-screen .key {
    font-size: var(--font-small);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--color-key);
    background-color: var(--color-key-back);
    border-width: var(--border-thin);
    border-color: var(--color-key-border);
    border-radius: var(--radius);
    margin: 0 var(--space-small) 0 0;
    padding: 0 var(--space-small);
}

.lh-screen .key--gamepad {
    display: none;
}

.lh-screen.lh-gamepad .key--gamepad {
    display: flex;
}

.lh-screen.lh-gamepad .key--keyboard {
    display: none;
}
