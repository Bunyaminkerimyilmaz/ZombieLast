# Last Haven — .gitattributes

# Varsayılan: git metin/ikili ayrımını kendisi yapar, metinde satır sonlarını normalize eder.
* text=auto

# --- Kod ve metin kaynakları ---
*.cs      text diff=csharp
*.asmdef  text
*.asmref  text
*.json    text
*.md      text
*.uxml    text
*.uss     text
*.tss     text
*.shader  text
*.hlsl    text
*.cginc   text

# --- Unity YAML dosyaları ---
# Unity bunları her platformda LF ile yazar; eol=lf gereksiz "değişti" görünmesini önler.
# `text` bilerek yazılmadı: bazı .asset dosyaları (ör. LightingData) ikilidir;
# text=auto onları otomatik ikili sayar ve bozmaz.
#
# merge=unityyamlmerge isteğe bağlıdır. Tanımlı değilse git normal birleştirme yapar.
# Unity Smart Merge kullanmak isteyen, kendi makinesinde bir kez şunu çalıştırır
# (yolu kendi Unity kurulumuna göre düzelt):
#   git config merge.unityyamlmerge.name "Unity SmartMerge"
#   git config merge.unityyamlmerge.driver "'<Unity>/Editor/Data/Tools/UnityYAMLMerge' merge -p %O %B %A %A"
#   git config merge.unityyamlmerge.recursive binary
*.unity               merge=unityyamlmerge eol=lf
*.prefab              merge=unityyamlmerge eol=lf
*.asset               merge=unityyamlmerge eol=lf
*.meta                merge=unityyamlmerge eol=lf
*.mat                 merge=unityyamlmerge eol=lf
*.anim                merge=unityyamlmerge eol=lf
*.controller          merge=unityyamlmerge eol=lf
*.overrideController  merge=unityyamlmerge eol=lf
*.mixer               merge=unityyamlmerge eol=lf
*.physicMaterial      merge=unityyamlmerge eol=lf
*.mask                merge=unityyamlmerge eol=lf
*.playable            merge=unityyamlmerge eol=lf
*.lighting            merge=unityyamlmerge eol=lf
*.preset              merge=unityyamlmerge eol=lf
*.renderTexture       merge=unityyamlmerge eol=lf
*.spriteatlas         merge=unityyamlmerge eol=lf
*.terrainlayer        merge=unityyamlmerge eol=lf
*.shadergraph         eol=lf
*.shadersubgraph      eol=lf
*.inputactions        eol=lf

